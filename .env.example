# ---------- Base de datos ----------
POSTGRES_DB=monitor_servidores
POSTGRES_USER=admin
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_SEGURA

# ---------- Puertos y direcciones (las usa el NAVEGADOR) ----------
API_PORT=8080
FRONTEND_PORT=3000
# Si el 9090 ya lo usa otro programa, cambia este número (ej. 9091)
PROMETHEUS_PORT=9090
API_URL=http://localhost:8080
# Segunda aplicación (demo de SSO)
PORTAL2_PORT=3001
PORTAL2_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ---------- Seguridad ----------
# Primer administrador (correo o proveedor:id). Se ve en la tarjeta "Identidad".
# Los demás roles se asignan desde el panel "Administración de usuarios y roles".
ADMINISTRADORES_INICIALES=
# Datos de ejemplo para los reportes (true/false)
DATOS_DEMO=true

# ---------- Docker Hub (release) ----------
DOCKERHUB_USER=tu_usuario_dockerhub
IMAGE_NAME=monitor-api
IMAGE_TAG=1.0.0

# ---------- Proveedores OAuth ----------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con el Redirect URI registrado en Dropbox
DROPBOX_REDIRECT_URI=http://localhost:8080/signin-dropbox

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack exige HTTPS en el Redirect URI (ver docs/ENTREGA.md)
SLACK_REDIRECT_URI=https://localhost:8443/signin-slack

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok (Login Kit Web). TikTok exige HTTPS en el Redirect URI: usa el túnel
# ngrok apuntando a la API (ngrok http 8080). Debe terminar en /signin-tiktok
# y coincidir EXACTAMENTE con el registrado en TikTok for Developers.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://TU-DOMINIO.ngrok-free.dev/signin-tiktok
